{
  "realm": "science-alerts-saas",
  "displayName": "PubTracker",
  "displayNameHtml": "PubTracker",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "resetPasswordAllowed": true,
  "defaultRole": {
    "name": "default-roles-science-alerts-saas",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },
  "roles": {
    "realm": [
      {
        "name": "User",
        "description": "Standard PubTracker user"
      },
      {
        "name": "Admin",
        "description": "PubTracker administrator"
      },
      {
        "name": "default-roles-science-alerts-saas",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "User"
          ]
        },
        "clientRole": false
      }
    ]
  },
  "users": [
    {
      "username": "pubtracker-admin",
      "email": "pubtracker@protonmail.com",
      "enabled": true,
      "serviceAccountClientId": "pubtracker-admin",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "science-alerts-web",
      "name": "PubTracker Web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://pubtracker.org/*"
      ],
      "webOrigins": [
        "https://pubtracker.org"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "science-alerts-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "science-alerts-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "pubtracker-api-admin",
      "name": "PubTracker API (admin)",
      "description": "Lets the API update users' emails in Keycloak. Dev secret: replace it outside local development.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ]
}