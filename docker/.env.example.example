# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Password1
POSTGRES_DB=pubtracker_db
POSTGRES_PORT=5432

#API configuration
#Choose between "Development" or "Production"
ASPNETCORE_ENVIRONMENT=Development

# Scheduler configuration
# How often (in hours) the background worker polls search queries for new records
SCHEDULER_POLL_INTERVAL_HOURS=168

# Email / digest configuration
# Brevo API key and sender identity used to email subscribers when new records are found
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=PubTracker

# Web frontend configuration
# Baked into the static build at image-build time (Vite env vars are compiled in, not read
# at container runtime) - these must be URLs reachable from the user's browser. Re-run
# `docker compose build web` after changing any of these.
WEB_API_BASE_URL=http://localhost:8080
WEB_KEYCLOAK_AUTHORITY=http://localhost:8081/realms/science-alerts-saas
WEB_KEYCLOAK_CLIENT_ID=science-alerts-web
