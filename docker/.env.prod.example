# Production settings for docker-compose.prod.yml. Copy to `.env` ON THE VM (chmod 600).
# Never commit the real file; Jenkins never sees these values (see docs/adr/0001).

# Public address users type, no trailing slash. Also baked into the web image at build time.
PUBLIC_ORIGIN=https://pubtracker.org

# GHCR namespace (lowercase GitHub user/org that owns the images)
GHCR_OWNER=

POSTGRES_DB=pubtracker_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

KEYCLOAK_ADMIN_PASSWORD=
# Shared by Keycloak (realm import) and the API; pick a long random string.
KEYCLOAK_ADMIN_CLIENT_SECRET=

SCHEDULER_POLL_INTERVAL_HOURS=168

EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=PubTracker

NCBI_API_KEY=
NCBI_CONTACT_EMAIL=

# Optional AI digest summaries (blank = disabled)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
