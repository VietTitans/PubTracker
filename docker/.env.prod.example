# Production settings for docker-compose.prod.yml. Copy to `.env` ON THE VM (chmod 600).
# Never commit the real file; Jenkins never sees these values (see docs/adr/0001).

# Public address users type, no trailing slash. Also baked into the web image at build time.
PUBLIC_ORIGIN=https://pubtracker.org

# GHCR namespace (lowercase GitHub user/org that owns the images)
GHCR_OWNER=

POSTGRES_DB=pubtracker_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

KEYCLOAK_ADMIN_PASSWORD=
# Shared by Keycloak (realm import) and the API; pick a long random string.
KEYCLOAK_ADMIN_CLIENT_SECRET=

SCHEDULER_POLL_INTERVAL_HOURS=168

EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=PubTracker

# Nightly encrypted backups to Cloudflare R2 (setup steps: docs/runbooks/backup-restore.md).
# BACKUP_AGE_RECIPIENT is the age PUBLIC key; the matching private key stays offline, never on the VM.
BACKUP_AGE_RECIPIENT=
# EU-jurisdiction endpoint: https://<account-id>.eu.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=
# Dumps older than this are deleted after a successful run (rclone duration).
BACKUP_RETENTION=14d
# Healthchecks.io ping URL, hit after each successful run. Required: it is the missed-backup alert.
BACKUP_HEARTBEAT_URL=

NCBI_API_KEY=
NCBI_CONTACT_EMAIL=

# Optional AI digest summaries (blank = disabled)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
